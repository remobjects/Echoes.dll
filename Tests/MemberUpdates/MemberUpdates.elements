<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <Mode>Echoes</Mode><TargetFramework>.NET10.0</TargetFramework><NETCoreRuntimeVersion>10.0.0</NETCoreRuntimeVersion>
    <OutputType>Exe</OutputType><AssemblyName>MemberUpdates</AssemblyName><EnableAsserts>True</EnableAsserts>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>Bin/$(Configuration)</OutputPath>
    <EchoesRuntimeFolder Condition="'$(EchoesRuntimeFolder)' == ''">../../Bin/NETStandard2.0</EchoesRuntimeFolder>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'"><Optimize>False</Optimize></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'"><Optimize>True</Optimize></PropertyGroup>
  <ItemGroup>
    <Reference Include="#"/>
    <Reference Include="Echoes"><HintPath>$(EchoesRuntimeFolder)/Echoes.dll</HintPath><Private>True</Private></Reference>
    <Compile Include="Program.pas"/>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)/RemObjects Software/Elements/RemObjects.Elements.Echoes.targets"/>
</Project>
